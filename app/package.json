{
  "name": "hermes-one",
  "productName": "Hermes One",
  "version": "0.3.3",
  "private": true,
  "description": "An unofficial desktop app for Hermes Agent: one chat with your lead agent, who runs the rest of your agents.",
  "license": "MIT",
  "author": "Charul Dalvi",
  "repository": "github:charuldalvi/hermes-one",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && node scripts/run.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "package:win": "npm run build && node scripts/package-win.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@novnc/novnc": "^1.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.9.3",
    "esbuild": "^0.25.12",
    "marked": "^15.0.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
